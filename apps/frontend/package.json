{
  "name": "basecamp-outdoor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integ.test.*\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "pre-commit": "npm run lint && npm run format:check",
    "pre-push": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.1.0",
    "lucide-react": "^0.400.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
