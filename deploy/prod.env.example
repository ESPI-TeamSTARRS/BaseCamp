# Modele du fichier /opt/basecamp/.env de la VM (hors depot, droits 600, proprietaire deploy).
# Ne JAMAIS commiter la version remplie. Toutes les valeurs ci-dessous sont des marqueurs.
#
# Les references d'images (FRONT_IMAGE, SHOP_IMAGE, PAYMENT_IMAGE, AUTH_IMAGE) ne se saisissent
# pas ici : elles sont ecrites dans /opt/basecamp/release.env par scripts/deploy.sh a partir du
# manifeste de release, sous la forme ghcr.io/espi-teamstarrs/basecamp-<service>@sha256:<digest>.

# --- Domaine et Traefik du serveur ---
BASECAMP_DOMAIN=basecamp.example.test
# Valeurs observees sur la VM ; a ne changer que si le Traefik du serveur change.
WEB_NETWORK=web
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Reseaux autorises a fournir X-Forwarded-* (reseaux Docker). Valeur par defaut : 172.16.0.0/12.
# PROXY_TRUSTED_IPS=172.16.0.0/12

# Test AVANT la bascule : GATEWAY_EXPOSE=false demarre la pile sans que le Traefik du serveur la route
# (aucun conflit avec l'ancienne pile sur le meme domaine). Supprimer la ligne pour exposer la pile.
# GATEWAY_EXPOSE=false

# --- Emplacement des cles de signature d'auth (generees sur la VM, jamais versionnees) ---
SECRETS_DIR=/opt/basecamp/secrets

# --- Postgres (compte administrateur : reserve a l'initialisation) ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# --- Bases propres a chaque service ---
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=change-me
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=change-me
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me

# --- Back-office (eteint par defaut) : voir docs/deployment/runbook.md, "Activer le back-office" ---
# L'activation exige le secret ${SECRETS_DIR}/auth/face-template.key (cree a la main sur la VM).
# AUTH_BACKOFFICE_ENABLED=true
# AUTH_FACE_VERIFIER=visage-id
# AUTH_FACE_THRESHOLD=0.23

# --- Journalisation metier : cle HMAC des empreintes d'email (commune aux services, a generer) ---
# Exemple de generation : openssl rand -hex 32. Changer la cle change toutes les empreintes.
LOG_PSEUDONYM_KEY=change-me

# --- Jetons de service (auth) : secret du client "shop", lu uniquement par auth-bootstrap ---
# Au moins 32 caracteres (genere par l'installation). Rotation : nouveau secret ici, l'ancien dans
# AUTH_SERVICE_CLIENT_SECRET_SHOP_PREVIOUS, redeployer, mettre a jour l'appelant, puis vider PREVIOUS
# (voir docs/services/auth.md).
AUTH_SERVICE_CLIENT_SECRET_SHOP=change-me
# AUTH_SERVICE_CLIENT_SECRET_SHOP_PREVIOUS=

# --- Webhook signe payment -> shop (service payment-worker) ---
# Secret de signature, au moins 32 caracteres (genere par l'installation, uniquement sur la VM).
# Rotation : nouveau secret ici, l'ancien dans PAYMENT_WEBHOOK_SECRET_PREVIOUS, redeployer, mettre a
# jour la boutique, puis vider PREVIOUS (voir docs/services/payment.md).
PAYMENT_WEBHOOK_SECRET=change-me
# PAYMENT_WEBHOOK_SECRET_PREVIOUS=
# PAYMENT_WEBHOOK_URL=http://shop:8000/webhooks/payment
# Email de confirmation de commande envoye par shop : relais SMTP facultatif (sans relais, l'echec
# d'envoi est journalise "order.confirmation_email_failed" et la commande reste confirmee).
# SHOP_SMTP_HOST=
# SHOP_SMTP_PORT=25
# SHOP_SMTP_FROM=commandes@basecamp.local
# Envoi des mails par le workflow n8n (production) : MAIL_TRANSPORT=n8n exige N8N_MAIL_URL et N8N_MAIL_SECRET.
# Le secret est mis sur la VM par Sam, jamais dans le depot.
# MAIL_TRANSPORT=n8n
# N8N_MAIL_URL=https://<hote-n8n>/webhook/send-email
# N8N_MAIL_SECRET=

# --- Stockage objet S3 (SeaweedFS) ---
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=product-images

# --- Front (facultatif : le paiement est interne) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
