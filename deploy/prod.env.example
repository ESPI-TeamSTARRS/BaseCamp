# Modele du fichier /opt/basecamp/.env de la VM (hors depot, droits 600, proprietaire deploy).
# Ne JAMAIS commiter la version remplie. Toutes les valeurs ci-dessous sont des marqueurs.
#
# Les references d'images (FRONT_IMAGE, SHOP_IMAGE, PAYMENT_IMAGE, AUTH_IMAGE) ne se saisissent
# pas ici : elles sont ecrites dans /opt/basecamp/release.env par scripts/deploy.sh a partir du
# manifeste de release, sous la forme ghcr.io/espi-teamstarrs/basecamp-<service>@sha256:<digest>.

# --- Domaine et Traefik du serveur ---
BASECAMP_DOMAIN=basecamp.example.test
# Valeurs observees sur la VM ; a ne changer que si le Traefik du serveur change.
WEB_NETWORK=web
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Reseaux autorises a fournir X-Forwarded-* (reseaux Docker). Valeur par defaut : 172.16.0.0/12.
# PROXY_TRUSTED_IPS=172.16.0.0/12

# --- Emplacement des cles de signature d'auth (generees sur la VM, jamais versionnees) ---
SECRETS_DIR=/opt/basecamp/secrets

# --- Postgres (compte administrateur : reserve a l'initialisation) ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# --- Bases propres a chaque service ---
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=change-me
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=change-me
PAYMENT_SERVICE_TOKEN_SHOP=change-me
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me

# --- Journalisation metier : cle HMAC des empreintes d'email (commune aux services, a generer) ---
# Exemple de generation : openssl rand -hex 32. Changer la cle change toutes les empreintes.
LOG_PSEUDONYM_KEY=change-me

# --- Stockage objet S3 (SeaweedFS) ---
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=product-images

# --- Front (facultatif : le paiement est interne) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
