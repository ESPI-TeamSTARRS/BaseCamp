[Unit]
Description=Basecamp : deploiement du manifeste de release (par tirage)
Documentation=file:///opt/basecamp/repo/docs/deployment/runbook.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=basecamp
Group=basecamp
SupplementaryGroups=docker
ExecStart=/opt/basecamp/repo/scripts/pull-deploy.sh
TimeoutStartSec=30min
# Succes = 0. Code 1 (echec avec retour arriere) et 2 (retour arriere en echec) restent visibles
# dans `systemctl status` et le journal ; le minuteur ne rejoue pas un manifeste deja refuse.
Nice=10

# Durcissement : seuls /opt/basecamp et le socket Docker sont utiles.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/basecamp
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
