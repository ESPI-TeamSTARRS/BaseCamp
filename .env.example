# Copier en .env (ignore par Git) : cp .env.example .env
# Valeurs FACTICES pour le developpement local. Aucun secret reel ici.

# --- Passerelle (seul port publie sur l'hote, lie a 127.0.0.1) ---
GATEWAY_PORT=8080

# --- Postgres (compte administrateur : reserve a l'initialisation) ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-admin

# --- Base propre au service shop ---
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=change-me-shop

# --- Base propre au service payment (conteneur Postgres dedie) ---
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=change-me-payment
# Webhook signe payment -> shop (worker payment-worker). Secret d'au moins 32 caracteres, a regenerer.
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret-0123456789
# Rotation : placer ici l'ancien secret le temps que la boutique bascule, puis le retirer.
PAYMENT_WEBHOOK_SECRET_PREVIOUS=
# URL de la route interne de la boutique (POST /webhooks/payment, jamais routee par Traefik).
PAYMENT_WEBHOOK_URL=http://shop:8000/webhooks/payment
PAYMENT_WEBHOOK_MAX_ATTEMPTS=6
PAYMENT_WEBHOOK_BACKOFF_BASE_SECONDS=5

# --- Base propre au service auth (conteneur Postgres dedie, reseau isole) ---
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me-auth

# --- Jetons de service (auth) : secret du client "shop", lu uniquement par auth-bootstrap ---
# Au moins 32 caracteres. Rotation : mettre le nouveau secret ici, l'ancien dans
# AUTH_SERVICE_CLIENT_SECRET_SHOP_PREVIOUS, relancer `docker compose run --rm auth-bootstrap`,
# puis mettre a jour l'appelant; vider PREVIOUS ensuite (voir docs/services/auth.md).
AUTH_SERVICE_CLIENT_SECRET_SHOP=change-me-auth-service-client-shop-000
AUTH_SERVICE_CLIENT_SECRET_SHOP_PREVIOUS=

# --- Emails d'auth (verification d'adresse) : Mailpit, boite mail de developpement ---
# Mailpit n'est pas publie ni route par la passerelle. Pour lire les emails depuis l'hote
# (scenarios e2e), ajouter la surcharge : docker compose -f docker-compose.yml -f docker-compose.e2e.yml
AUTH_SMTP_FROM=comptes@basecamp.local
# Email de confirmation de commande envoye par shop (webhook de paiement recu) dans Mailpit.
SHOP_SMTP_FROM=commandes@basecamp.local
# Transport des emails des services : smtp (Mailpit, defaut) ou n8n (webhook). Avec n8n, URL et secret
# sont obligatoires ; ne jamais committer le secret.
MAIL_TRANSPORT=smtp
# N8N_MAIL_URL=
# N8N_MAIL_SECRET=
MAILPIT_PORT=8025

# --- Cles de signature des jetons (auth) ---
# Generees par `sh scripts/init-auth-keys.sh` dans .secrets/ (ignore par Git) : jamais de cle ici.

# --- Stockage objet S3 (SeaweedFS) : images produit ---
S3_ACCESS_KEY=basecamp-s3
S3_SECRET_KEY=change-me-s3
S3_BUCKET=product-images

# --- Frontend ---
# URL interne de l'API shop, lue cote serveur uniquement (pas de NEXT_PUBLIC_).
SHOP_API_URL=http://shop:8000
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Aucune cle de paiement : le paiement passe par le service payment (methodes de test).
RESEND_API_KEY=re_dummy
RESEND_FROM_EMAIL=commandes@basecamp.local
